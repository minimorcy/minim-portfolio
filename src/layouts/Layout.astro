---
import '../styles/global.css';
import siteConfig from '../config/site.json';
import { languages, defaultLang, getLocalizedPath, tr, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  pageTitle?: string;
  description?: string;
}

const { lang, pageTitle, description } = Astro.props;
const title = pageTitle || tr(siteConfig.homeTitle, lang);
const desc = description || tr(siteConfig.bio, lang);

const ogLocales: Record<Lang, string> = { es: 'es_ES', en: 'en_US' };
const urlFor = (code: Lang) => new URL(getLocalizedPath(code), siteConfig.siteUrl).href;
const canonicalUrl = urlFor(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />

    <title>{title}</title>

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:image" content={siteConfig.ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={siteConfig.ogImageUrl} />

    <!-- Canonical + language alternates -->
    <link rel="canonical" href={canonicalUrl} />
    {Object.keys(languages).map(code => (
      <link rel="alternate" hreflang={code} href={urlFor(code as Lang)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={urlFor(defaultLang)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={siteConfig.faviconPath} />

    <!-- PWA (Android TWA) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a0a0f" />
    <script is:inline>'serviceWorker' in navigator && navigator.serviceWorker.register('/sw.js');</script>

    <!-- JSON-LD Person Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": siteConfig.nickname,
      "url": siteConfig.siteUrl,
      "jobTitle": tr(siteConfig.tagline, lang),
      "sameAs": [
        siteConfig.githubUrl,
        siteConfig.linkedinUrl
      ]
    })} />
  </head>
  <body class="dark">
    <nav class="lang-switcher mono" aria-label={tr(siteConfig.languageSwitcherLabel, lang)}>
      {Object.entries(languages).map(([code, label]) => (
        <a
          href={getLocalizedPath(code as Lang)}
          hreflang={code}
          aria-current={code === lang ? 'page' : undefined}
          class:list={['lang-link', { 'lang-link--active': code === lang }]}
        >
          {label}
        </a>
      ))}
    </nav>
    <div class="container">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  .lang-switcher {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 10;
    display: flex;
    gap: 0.75rem;
    font-size: 0.8rem;
  }

  .lang-link {
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.2rem 0.1rem;
    transition: color 0.2s ease;
  }

  .lang-link:hover {
    color: var(--accent-cyan);
  }

  .lang-link--active {
    color: var(--accent-cyan);
    border-bottom: 1px solid var(--accent-cyan);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  @media (min-width: 1024px) {
    .container {
      padding: 4rem;
    }
  }
</style>
