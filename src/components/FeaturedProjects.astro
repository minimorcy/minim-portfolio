---
import featuredConfig from '../config/featured-projects.json';
import type { FeaturedProjectsConfig } from '../types';
import { tr, type Lang, type Localized } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (value: Localized) => tr(value, lang);

const { title, subtitle, privateLabel, buildingLabel, demoLabel, repoLabel, projects } =
  featuredConfig as FeaturedProjectsConfig;
---

{projects.length > 0 && (
  <section id="projects">
    <header class="featured-header">
      <h2 class="section-title mono">{t(title)}</h2>
      {subtitle && <p class="featured-subtitle">{t(subtitle)}</p>}
    </header>

    <div class="featured-grid">
      {projects.map(project => (
        <article class="featured-card glass-card">
          {project.image && (
            <a class="featured-media" href={project.image} target="_blank" rel="noopener">
              <img class="featured-image" src={project.image} alt={t(project.name)} loading="lazy" />
            </a>
          )}

          <div class="featured-body">
            <div class="featured-top">
              <h3 class="featured-name">{t(project.name)}</h3>
              {(project.private || project.building) && (
                <div class="featured-badges">
                  {project.building && (
                    <span class="featured-badge featured-badge--building mono">
                      <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                      {t(buildingLabel)}
                    </span>
                  )}
                  {project.private && (
                    <span class="featured-badge featured-badge--private mono">
                      <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                      {t(privateLabel)}
                    </span>
                  )}
                </div>
              )}
            </div>

            <p class="featured-summary">{t(project.summary)}</p>

            {project.stack && project.stack.length > 0 && (
              <ul class="featured-stack">
                {project.stack.map(tech => <li class="featured-chip mono">{tech}</li>)}
              </ul>
            )}

            {(project.demoUrl || project.repoUrl) && (
              <div class="featured-links mono">
                {project.demoUrl && (
                  <a href={project.demoUrl} target="_blank" rel="noopener noreferrer">{t(demoLabel)}</a>
                )}
                {project.repoUrl && (
                  <a href={project.repoUrl} target="_blank" rel="noopener noreferrer">{t(repoLabel)}</a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  #projects {
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .featured-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 2rem;
    color: var(--accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .featured-subtitle {
    margin-top: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .featured-grid {
    display: grid;
    gap: 2rem;
  }

  .featured-card {
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .featured-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 20px var(--accent-dim);
    border-color: var(--accent-cyan);
  }

  .featured-card:nth-child(even) {
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
  }

  .featured-card:nth-child(even) .featured-media {
    order: 2;
    border-right: none;
    border-left: 1px solid var(--border-glow);
  }

  .featured-media {
    display: block;
    align-self: center;
    border-right: 1px solid var(--border-glow);
    cursor: zoom-in;
  }

  .featured-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .featured-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .featured-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .featured-name {
    font-size: 1.2rem;
    color: var(--text-primary);
  }

  .featured-badges {
    flex-shrink: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .featured-badge--private {
    color: var(--accent-violet);
    border: 1px solid rgba(176, 38, 255, 0.4);
  }

  .featured-badge--building {
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.4);
    background: rgba(251, 191, 36, 0.08);
  }

  .featured-summary {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .featured-stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .featured-chip {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 10px;
    background: var(--bg-secondary);
    color: var(--text-muted);
  }

  .featured-links {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    gap: 1.25rem;
    font-size: 0.85rem;
  }

  .featured-links a {
    color: var(--accent-cyan);
    font-weight: 600;
    text-decoration: none;
  }

  .featured-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .featured-card,
    .featured-card:nth-child(even) {
      grid-template-columns: 1fr;
    }

    .featured-media,
    .featured-card:nth-child(even) .featured-media {
      order: 0;
      border-left: none;
      border-right: none;
      border-bottom: 1px solid var(--border-glow);
    }
  }

  @media (max-width: 768px) {
    #projects {
      padding: 3rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card,
    .featured-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
