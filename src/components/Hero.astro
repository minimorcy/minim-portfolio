---
import siteConfig from '../config/site.json';

const isExternalCta = siteConfig.ctaPrimaryHref.startsWith('http');
---

<section class="hero">
  <div class="hero-bg-glow"></div>
  <div class="hero-content">
    <h1 class="nickname glitch-text" aria-label={siteConfig.heroAriaLabel}>
      <span class="tag">&lt;{siteConfig.nickname} /&gt;</span>
    </h1>
    <p class="tagline mono">{siteConfig.tagline}</p>
    <p class="bio">{siteConfig.bio}</p>
    <div class="cta-group">
      <a
        href={siteConfig.ctaPrimaryHref}
        class="cta-primary glass-card"
        {...(isExternalCta && { target: '_blank', rel: 'noopener noreferrer' })}
      >{siteConfig.ctaPrimaryText}</a>
      <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="cta-secondary">{siteConfig.ctaSecondaryText}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .hero-bg-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 240, 255, 0.08) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
    padding: 2rem;
  }

  .nickname {
    font-size: 6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }

  .tag {
    color: var(--accent-cyan);
  }

  .glitch-text {
    animation: glitch 3s infinite;
  }

  .glitch-text:hover {
    animation-play-state: paused;
  }

  .tagline {
    font-size: 1.2rem;
    color: var(--accent-cyan);
    margin: 0.5rem 0;
  }

  .bio {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 1rem auto;
    line-height: 1.6;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .cta-primary {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 600;
  }

  .cta-secondary {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border-glow);
    text-decoration: none;
    color: var(--accent-cyan);
  }

  @media (max-width: 768px) {
    .nickname {
      font-size: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch-text {
      animation: none;
    }
  }
</style>
