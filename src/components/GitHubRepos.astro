---
import { getPortfolioRepos } from '../lib/github';
import siteConfig from '../config/site.json';
import reposConfig from '../config/repos-config.json';

const result = await getPortfolioRepos(siteConfig.githubUsername, reposConfig);
const repos = result.repos;
const error = result.error;
---

<section id="repos">
  <h2 class="section-title mono">{siteConfig.reposTitle}</h2>
  {
    error ? (
      <div class="error-state glass-card">
        {error.isAuthError ? (
          <p>
            {siteConfig.errorAuth}{' '}
            <a href={siteConfig.errorAuthLinkHref}>{siteConfig.errorAuthLinkText}</a>.
          </p>
        ) : error.isRateLimited ? (
          <p>{siteConfig.errorRateLimit}</p>
        ) : (
          <p>{siteConfig.errorGeneric}</p>
        )}
      </div>
    ) : repos.length === 0 ? (
      <div class="empty-state glass-card">
        <p>{siteConfig.emptyRepos}</p>
      </div>
    ) : (
      <div class="repos-grid">
        {repos.map((repo) => (
          <article
            class="repo-card glass-card"
            data-featured={repo.isFeatured ? 'true' : 'false'}
          >
            {repo.isFeatured && <span class="featured-badge mono">{siteConfig.featuredBadge}</span>}
            <h3 class="repo-name">
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {repo.name}
              </a>
            </h3>
            <p class="repo-desc">{repo.description}</p>
            <div class="repo-meta">
              {repo.language && <span class="lang-badge">{repo.language}</span>}
              <span class="stars mono">⭐ {repo.stars}</span>
            </div>
            {repo.topics.length > 0 && (
              <div class="topics">
                {repo.topics.map((topic) => (
                  <span class="topic-pill">{topic}</span>
                ))}
              </div>
            )}
            {repo.demoUrl && (
              <a
                href={repo.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="demo-link"
              >
                {siteConfig.demoLinkText}
              </a>
            )}
          </article>
        ))}
      </div>
    )
  }
</section>

<style>
  #repos {
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 2rem;
    color: var(--accent-cyan);
    text-align: center;
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .repos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .repo-card {
    position: relative;
    padding: 1.5rem;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .repo-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 20px var(--accent-dim);
    border-color: var(--accent-cyan);
  }

  .repo-card[data-featured='true'] {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.15);
  }

  .featured-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--accent-cyan);
    color: var(--bg-primary);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .repo-name a {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 1.1rem;
  }

  .repo-name a:hover {
    color: var(--accent-cyan);
  }

  .repo-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lang-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    background: var(--bg-secondary);
    color: var(--accent-cyan);
    border: 1px solid var(--border-glow);
  }

  .stars {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .repo-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .topic-pill {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 10px;
    background: var(--bg-secondary);
    color: var(--text-muted);
  }

  .demo-link {
    color: var(--accent-cyan);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .error-state,
  .empty-state {
    padding: 2rem;
    text-align: center;
    color: var(--text-secondary);
  }

  .error-state {
    border-color: rgba(255, 80, 80, 0.3);
  }

  .error-state a {
    color: var(--accent-cyan);
  }
</style>
